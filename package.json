{
  "name": "codex-tern",
  "version": "0.1.0",
  "private": true,
  "description": "A native Tern client for the official Codex app-server",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codex-tern": "bin/codex-tern"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "bun --bun tsc --noEmit && bun scripts/build.mjs",
    "start": "bun bin/codex-tern",
    "dev": "bun src/cli.ts",
    "test": "bun test test/",
    "test:ui": "bun scripts/ui-qa.mjs",
    "test:proposals": "bun scripts/proposals-qa.mjs",
    "test:sessions": "bun scripts/sessions-qa.mjs",
    "test:session-actions": "bun scripts/session-actions-qa.mjs",
    "test:session-titles": "bun scripts/session-titles-qa.mjs",
    "test:settings": "bun scripts/settings-qa.mjs",
    "test:sidebar-width": "bun scripts/sidebar-width-qa.mjs",
    "check": "bun --bun tsc --noEmit",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@oh-my-pi/pi-natives": "18.12.5",
    "@oh-my-pi/pi-tui": "18.12.5",
    "@stencil-hq/tern": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
